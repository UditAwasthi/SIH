# Shared remote development services
DATABASE_URL=
REDIS_URL=

JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Chat LLM (used for conversation). OpenAI is currently optional if Groq/Ollama is set.
# Groq is recommended: fast + free tier — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: groq | openai | ollama
CHAT_PROVIDER=groq
# Local Ollama (optional): install Ollama, pull a model, then set:
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2

# Resend (https://resend.com) — leave unset to disable outbound email
RESEND_API_KEY=
# Verified sender, e.g. "PGRKAM AI <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=PGRKAM AI <onboarding@resend.dev>
# Public site URL used in email CTAs
FRONTEND_URL=http://localhost:3000

# Frontend-to-backend base URL (for example, http://localhost:3001)
NEXT_PUBLIC_API_URL=http://localhost:3001
